# Database (local or DATABASE_URL for hosted Postgres)
# DATABASE_URL=postgresql://...

# Clerk — grant/revoke Pro via Backend API; optional JWT verification for ENFORCE_API_PRO
# CLERK_SECRET_KEY=sk_test_...
# Issuer from Clerk Dashboard → API Keys → JWT issuer (e.g. https://YOUR_INSTANCE.clerk.accounts.dev)
# CLERK_JWT_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev

# Stripe — webhooks update Clerk public_metadata.plan; optional customer tagging for cancel/downgrade
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard: add endpoint POST https://YOUR_API_ORIGIN/webhooks/stripe (events: checkout.session.completed, customer.subscription.deleted, customer.subscription.updated)

# When true, /stats, /buildings/*, /solar/calculate require Authorization: Bearer <Clerk session JWT> and Pro plan
# ENFORCE_API_PRO=true
