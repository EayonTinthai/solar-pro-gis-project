# Clerk (required for auth UI)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Frontend-only: extra emails that get Pro UI without Stripe. Does not affect API if ENFORCE_API_PRO is enabled server-side.
# VITE_UNLIMITED_ACCESS_EMAILS=partner@example.com

# Display-only price string for the Upgrade modal UI (Stripe handles real pricing).
VITE_STRIPE_PRO_PRICE_DISPLAY="฿XXX / month"

# Stripe Payment Link (public URL) for upgrading to Pro.
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/REPLACE_ME

# Nabha Solar Buildings API (Cloud Run)
VITE_BUILDINGS_API_URL=https://buildings-api-715107904640.asia-southeast1.run.app

# Optional: FastAPI base URL for POST /solar/calculate (pvlib). Defaults to http://localhost:8001 when unset.
# VITE_SOLAR_API_URL=http://localhost:8001
