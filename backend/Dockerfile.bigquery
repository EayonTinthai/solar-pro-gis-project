FROM python:3.11-slim

# Build argument to force cache invalidation
ARG CACHE_BUST=2026-04-18

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install system dependencies for numpy/pandas/pvlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api_bigquery.py .
COPY weather_service.py .
COPY calculate_rankings.py .

# Copy application modules
COPY models/ ./models/
COPY services/ ./services/
COPY utils/ ./utils/

# Set environment variables (defaults, can be overridden in Cloud Run)
ENV LOG_LEVEL=INFO
ENV API_VERSION=2.2.0
ENV PYTHONUNBUFFERED=1

# Env vars are injected at runtime via Cloud Run
# Run with uvicorn
CMD ["uvicorn", "api_bigquery:app", "--host", "0.0.0.0", "--port", "8080"]
