# Clerk (required for auth UI)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Frontend-only: extra emails that get Pro UI without Stripe. Does not affect API if ENFORCE_API_PRO is enabled server-side.
# VITE_UNLIMITED_ACCESS_EMAILS=partner@example.com

# Display-only price string for the Upgrade modal UI (Stripe handles real pricing).
VITE_STRIPE_PRO_PRICE_DISPLAY="฿XXX / month"

# Stripe Payment Link (public URL) for upgrading to Pro.
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/REPLACE_ME

# Frontend-only demo lifecycle webhook endpoint.
# The app posts event payloads for pending/granted/expired lifecycle emails.
# VITE_DEMO_LIFECYCLE_WEBHOOK_URL=https://hooks.example.com/demo-lifecycle

# Optional bearer token for the lifecycle webhook endpoint.
# VITE_DEMO_LIFECYCLE_WEBHOOK_BEARER=replace_me

# Demo duration (days) before a granted demo expires.
# VITE_DEMO_DURATION_DAYS=14

# Frontend-only auto trial length (days) for newly signed-in users.
# Client-side only (localStorage), not backend-enforced.
# VITE_FRONTEND_AUTO_TRIAL_DAYS=7

# Nabha Solar Buildings API (Cloud Run)
VITE_BUILDINGS_API_URL=https://solar-weather-api-715107904640.asia-southeast1.run.app

# Optional: FastAPI base URL for POST /solar/calculate (pvlib). Defaults to http://localhost:8001 when unset.
# VITE_SOLAR_API_URL=http://localhost:8001
